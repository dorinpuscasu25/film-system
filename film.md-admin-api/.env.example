APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CLIENT_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
API_TOKEN_TTL_MINUTES=10080
REGISTRATION_CODE_TTL_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=film_md
DB_USERNAME=postgres
DB_PASSWORD=postgres
ANALYTICS_DB_CONNECTION=pgsql
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_DATABASE=film_md_analytics
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=postgres
DATABASE_BACKUP_RETENTION_DAYS=14

# Backups (configured from the admin: Setări → Backup-uri)
# BACKUP_DIR defaults to storage/app/backups; docker-compose sets /var/backups/film-md.
# BACKUP_DIR=
# Required to enable encryption of backup files. Keep a copy outside the server:
# without it encrypted backups cannot be restored. Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_TIMEOUT=10800

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

SEARCH_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILISEARCH_CONTENT_INDEX=storefront_content

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_ANALYTICS_QUEUE=analytics

BUNNY_STREAM_BASE_URL=
BUNNY_STREAM_TOKEN_KEY=
# Serve the resolved HLS playlist to the web player instead of Bunny's iframe.
# Required for ad breaks and our own subtitle/quality controls on web.
# Keep false until DRM (MediaCage) and CORS are confirmed working in the browser,
# otherwise protected titles will fail to play.
BUNNY_WEB_NATIVE_PLAYBACK=false
BUNNY_WEBHOOK_SECRET=

PAY_FILMOTECA_BASE_URL=https://pay.filmoteca.md
PAY_FILMOTECA_USERNAME=
PAY_FILMOTECA_PASSWORD=
PAY_FILMOTECA_API_KEY=
PAY_FILMOTECA_CALLBACK_URL=http://localhost:8000/api/v1/payments/pay-filmoteca/callback
PAY_FILMOTECA_SUCCESS_URL=http://localhost:5174/payment/success
PAY_FILMOTECA_FAILED_URL=http://localhost:5174/payment/failed
PAY_FILMOTECA_TIMEOUT=20
# Card top-ups. PAYMENTS_CARD_PROVIDER: cybersource (Victoriabank, direct) or pay_filmoteca (legacy).
PAYMENTS_CARD_ENABLED=true
PAYMENTS_CARD_PROVIDER=pay_filmoteca

# Victoriabank cards via CyberSource Unified Checkout. Keys: Business Center (TEST) → Key Management →
# REST – Shared Secret. For the bank simulator: CYBERSOURCE_BASE_URL=http://127.0.0.1:8770, MID vb_sim_merchant.
CYBERSOURCE_ENABLED=false
CYBERSOURCE_ENVIRONMENT=test
CYBERSOURCE_BASE_URL=
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=
# Exact origins of the pages that show the card form (https, no path), comma-separated.
CYBERSOURCE_TARGET_ORIGINS=http://localhost:5174
# false = AUTH then capture (bank default); true = sale.
CYBERSOURCE_CAPTURE=false
CYBERSOURCE_PAYMENT_TYPES=PANENTRY
CYBERSOURCE_ACCEPT_ATTEMPTED_3DS=
# Webhook subscription (POST https://<api-host>/api/v1/webhooks/cybersource).
CYBERSOURCE_WEBHOOK_KEY_ID=
CYBERSOURCE_WEBHOOK_KEY=
CYBERSOURCE_WEBHOOK_MLE_PRIVATE_KEY_PATH=
CYBERSOURCE_WEBHOOK_MLE_PRIVATE_KEY_PASSPHRASE=
CYBERSOURCE_TIMEOUT=65

# Victoriabank MIA (instant QR). Bank signals arrive at https://<api-host>/api/signals.
MIA_ENABLED=false
MIA_BASE_URL=https://test-ipspj.victoriabank.md
MIA_USERNAME=
MIA_PASSWORD=
MIA_IBAN=
MIA_DBA=Filmoteca
MIA_QR_TTL_MINUTES=15
MIA_TIMEOUT=30
# Comma-separated PEM paths; defaults to the bundled resources/victoriabank/VBCA.crt.
MIA_SIGNAL_CERTIFICATES=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@filmoteca.md"
MAIL_FROM_NAME="FILMOTECA.md"
MAIL_EHLO_DOMAIN=filmoteca.md

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
# In production use the R2 custom domain, for example https://cdn.filmoteca.md.
# Do not use the rate-limited *.r2.dev public development URL.
AWS_URL=
# Previous public base URL, kept temporarily while existing database URLs are migrated.
AWS_LEGACY_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_API_TOKEN=

# Apple In-App Purchase (iOS credit packs). Safe to leave all unset for local `.storekit`-file
# development. See docs/ios-in-app-purchase-audit.md and config/services.php.
APPLE_BUNDLE_ID=md.filmoteca.ios
APPLE_APP_APPLE_ID=6790725769
# Download from https://www.apple.com/certificateauthority/AppleRootCA-G3.cer (public, no Apple
# account needed). Bundled at resources/apple/AppleRootCA-G3.cer; set this only to override.
APPLE_ROOT_CA_PATHS=
APPLE_IAP_ENABLE_ONLINE_CHECKS=true
APPLE_IAP_SANDBOX_FOR_ALL_ACCOUNTS=true
APPLE_IAP_SIGNING_KEY=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=

# IMDb ratings are fetched from OMDb (free key, 1,000 requests/day): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

VITE_APP_NAME="${APP_NAME}"
