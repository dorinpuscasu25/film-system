APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CLIENT_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
API_TOKEN_TTL_MINUTES=10080
REGISTRATION_CODE_TTL_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=film_md
DB_USERNAME=postgres
DB_PASSWORD=postgres
ANALYTICS_DB_CONNECTION=pgsql
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_DATABASE=film_md_analytics
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=postgres
DATABASE_BACKUP_RETENTION_DAYS=14

# Backups (configured from the admin: Setări → Backup-uri)
# BACKUP_DIR defaults to storage/app/backups; docker-compose sets /var/backups/film-md.
# BACKUP_DIR=
# Required to enable encryption of backup files. Keep a copy outside the server:
# without it encrypted backups cannot be restored. Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_TIMEOUT=10800

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

SEARCH_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILISEARCH_CONTENT_INDEX=storefront_content

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_ANALYTICS_QUEUE=analytics

BUNNY_STREAM_BASE_URL=
BUNNY_STREAM_TOKEN_KEY=
# Serve the resolved HLS playlist to the web player instead of Bunny's iframe.
# Required for ad breaks and our own subtitle/quality controls on web.
# Keep false until DRM (MediaCage) and CORS are confirmed working in the browser,
# otherwise protected titles will fail to play.
BUNNY_WEB_NATIVE_PLAYBACK=false
BUNNY_WEBHOOK_SECRET=

PAY_FILMOTECA_BASE_URL=https://pay.filmoteca.md
PAY_FILMOTECA_USERNAME=
PAY_FILMOTECA_PASSWORD=
PAY_FILMOTECA_API_KEY=
PAY_FILMOTECA_CALLBACK_URL=http://localhost:8000/api/v1/payments/pay-filmoteca/callback
PAY_FILMOTECA_SUCCESS_URL=http://localhost:5174/payment/success
PAY_FILMOTECA_FAILED_URL=http://localhost:5174/payment/failed
PAY_FILMOTECA_TIMEOUT=20

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@filmoteca.md"
MAIL_FROM_NAME="FILMOTECA.md"
MAIL_EHLO_DOMAIN=filmoteca.md

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
# In production use the R2 custom domain, for example https://cdn.filmoteca.md.
# Do not use the rate-limited *.r2.dev public development URL.
AWS_URL=
# Previous public base URL, kept temporarily while existing database URLs are migrated.
AWS_LEGACY_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_API_TOKEN=

# Apple In-App Purchase (iOS credit packs). Safe to leave all unset for local `.storekit`-file
# development. See docs/ios-in-app-purchase-audit.md and config/services.php.
APPLE_BUNDLE_ID=md.filmoteca.ios
APPLE_APP_APPLE_ID=
# Download from https://www.apple.com/certificateauthority/AppleRootCA-G3.cer (public, no Apple
# account needed) and place at storage/app/apple/AppleRootCA-G3.cer, or point this at another path.
APPLE_ROOT_CA_PATHS=
APPLE_IAP_ENABLE_ONLINE_CHECKS=true
APPLE_IAP_SIGNING_KEY=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=

VITE_APP_NAME="${APP_NAME}"
